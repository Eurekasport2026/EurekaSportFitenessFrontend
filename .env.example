# ==============================================================================
# Eureka Sport & Fitness Frontend — Environment Configuration Template
# ==============================================================================

# Retained practical-resource adapter only. Auth/catalog/progress always use APIs.
# Keep true until practical-resource endpoints are implemented.
NEXT_PUBLIC_USE_MOCK_DATA=true

# All public and authenticated requests use this server-only backend base URL.
# Set an explicit HTTPS /api/v1 URL for each production/preview deployment.
EUREKA_API_URL=http://localhost:8000/api/v1

# Fallback for the retained practical-resource adapter only.
NEXT_PUBLIC_MOCK_FALLBACK=true

# API Request Timeout in Milliseconds (default: 8000)
NEXT_PUBLIC_API_TIMEOUT_MS=8000

# Legacy EUREKA_AUTH_API_URL / EUREKA_COURSES_API_URL are aliases only.
# If present alongside EUREKA_API_URL, their normalized values must match.
