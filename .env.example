# ==============================================================================
# Eureka Sport & Fitness Frontend — Environment Configuration Template
# ==============================================================================

# Toggle between Local Mock Datasets (true) and Live Backend API (false)
# Default: true (safe offline development mode)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Base URL for the Backend REST API (FastAPI / Node.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Resilience Fallback: If live API returns an error or is offline, fall back to mock data
# Default: true (prevents broken UI pages during backend development/deployments)
NEXT_PUBLIC_MOCK_FALLBACK=true

# API Request Timeout in Milliseconds (default: 8000)
NEXT_PUBLIC_API_TIMEOUT_MS=8000

# Auth backend base URL, including /api/v1 (server-side; independent of mock data)
EUREKA_AUTH_API_URL=https://api-production-c166.up.railway.app/api/v1
